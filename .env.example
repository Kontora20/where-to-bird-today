# Copy to .env and replace every PLACEHOLDER with a real value.
# .env is gitignored. This file holds PLACEHOLDERS ONLY — never real secrets.

# --- eBird API 2.0 -----------------------------------------------------------
# Request a key at https://ebird.org/api/keygen
# Sent as the X-eBirdApiToken header (master plan §5).
EBIRD_API_KEY=PLACEHOLDER

# --- HTTP server -------------------------------------------------------------
PORT=8080
LOG_LEVEL=info

# --- PostgreSQL + PostGIS ----------------------------------------------------
# These match deploy/docker-compose.yml. Change them together.
POSTGRES_USER=birder
POSTGRES_PASSWORD=PLACEHOLDER
POSTGRES_DB=wheretobird
# Host port to publish the container on. Change it if you already run
# Postgres natively on 5432; the container always listens on 5432 internally.
POSTGRES_PORT=5432
DATABASE_URL=postgres://birder:PLACEHOLDER@localhost:5432/wheretobird?sslmode=disable
